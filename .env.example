# Neon Postgres. Pooled for the app, direct for migrations.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require

# Signs the session JWTs that Go verifies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional — the button is hidden until both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# type "Web application". Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
# and, once deployed, https://your-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pack generation (optional — only needed for pnpm packs:generate)
AI_GATEWAY_API_KEY=
