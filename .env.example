# Neon Postgres. Pooled for the app, direct for migrations.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require

# Signs the session JWTs that Go verifies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin the web app is served from. Google's redirect URI is derived from
# this, so if it is wrong the OAuth callback will not match what you registered.
#   local:      http://localhost:3000
#   production: https://wordle.jerkeyray.com
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional — the button is hidden until both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# type "Web application". Register both environments on the one client:
#
#   Authorised JavaScript origins
#     http://localhost:3000
#     https://wordle.jerkeyray.com
#
#   Authorised redirect URIs
#     http://localhost:3000/api/auth/callback/google
#     https://wordle.jerkeyray.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pack generation (optional — only needed for pnpm packs:generate)
AI_GATEWAY_API_KEY=
