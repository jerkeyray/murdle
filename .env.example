# Neon Postgres. Pooled for the app, direct for migrations.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require

# Signs the session JWTs that Go verifies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Pack generation (optional — only needed for pnpm packs:generate)
AI_GATEWAY_API_KEY=
