{
  "name": "wordle-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dictionary": "node scripts/build-dictionary.mjs && node scripts/build-client-dictionary.mjs",
    "packs:generate": "node scripts/generate-packs.mjs",
    "packs:review": "node scripts/review-packs.mjs",
    "packs:check": "node scripts/check-packs.mjs",
    "answers:queue:check": "node scripts/check-answer-queue.mjs",
    "test:content": "node --test scripts/packs-lib.test.mjs scripts/wiktionary-lib.test.mjs scripts/tatoeba-lib.test.mjs scripts/respell.test.mjs",
    "entries:enrich": "node scripts/enrich-entries.mjs --source wiktionary && node scripts/enrich-entries.mjs --source wordnet && node scripts/enrich-entries.mjs --source tatoeba",
    "entries:report": "node scripts/enrich-entries.mjs --report",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ai": "^7.0.124",
    "better-auth": "^1.7.6",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "word-list": "^4.1.0",
    "wordnet-db": "3.1.14"
  },
  "packageManager": "pnpm@10.30.2"
}
